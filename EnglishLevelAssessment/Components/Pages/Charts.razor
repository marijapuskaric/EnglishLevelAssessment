@page "/results"
@inject ResultService resultService
@inject LanguageLevelService languageLevelService
@rendermode InteractiveServer

<PageTitle>Results</PageTitle>

<Tabs EnableFadeEffect="true">
    <Tab Title="Rezultati" IsActive="true">
        <Content>
            <Grid TItem="Vresult"
                  Class="table table-hover table-bordered table-striped"
                  DataProvider="ResultsDataProvider"
                  AllowPaging="true"
                  PageSize="10"
                  AllowSorting="true"
                  AllowFiltering="true"
                  Responsive="true"
                  Style="height:55rem">
                  <GridColumn TItem="Vresult" HeaderText="Smjer" PropertyName="StudyProgramme" SortKeySelector="item=>item.StudyProgramme" Class="w-25">
                      @{
                          var studyProgramme = context?.StudyProgramme ?? "";
                      }
                      @studyProgramme
                  </GridColumn>
                <GridColumn TItem="Vresult" HeaderText="Godina" PropertyName="AcademicYear" SortKeySelector="item=>item.AcademicYear">
                    @{
                        var academicYear = context?.AcademicYear ?? "";
                    }
                    @academicYear
                </GridColumn>
                <GridColumn TItem="Vresult" HeaderText="Razina mature" PropertyName="MaturaLevel" SortKeySelector="item=>item.MaturaLevel">
                    @{
                        var maturaLevel = context?.MaturaLevel ?? "";
                    }
                    @maturaLevel
                </GridColumn>
                <GridColumn TItem="Vresult" HeaderText="Ocjena mature" PropertyName="MaturaGrade" SortKeySelector="item=>item.MaturaGrade">
                    @{
                        var maturaGrade = context?.MaturaGrade ?? "";
                    }
                    @maturaGrade
                </GridColumn>
                <GridColumn TItem="Vresult" HeaderText="Točni odgovori / broj pitanja" PropertyName="NumberOfCorrectAnswers" SortKeySelector="item=>item.NumberOfCorrectAnswers">
                    @{
                        var numberOfCorrectAnswers = context?.NumberOfCorrectAnswers ?? 0;
                        var numberOfQuestions = context?.NumberOfQuestions ?? 0;
                    }
                    @numberOfCorrectAnswers / @numberOfQuestions
                </GridColumn>
                <GridColumn TItem="Vresult" HeaderText="Samostalna procjena" PropertyName="SelfAssessedLanguageLevel" SortKeySelector="item=>item.SelfAssessedLanguageLevel">
                    @{
                        var selfAssessedLanguageLevel = context?.SelfAssessedLanguageLevel ?? "";
                    }
                    @selfAssessedLanguageLevel
                </GridColumn>
                <GridColumn TItem="Vresult" HeaderText="Rezultat online testa" PropertyName="LanguageLevelResult" SortKeySelector="item=>item.LanguageLevelResult">
                    @{
                        var languageLevelResult = context?.LanguageLevelResult ?? "<A1";
                    }
                    @languageLevelResult
                </GridColumn>
                <GridColumn TItem="Vresult" HeaderText="Datum ipunjavanja testa" PropertyName="CreatedAt" SortKeySelector="item=>item.CreatedAt">
                    @{
                        var createdAt = context?.CreatedAt.ToString() ?? "";
                    }
                    @createdAt
                </GridColumn>
            </Grid>
        </Content>
    </Tab>
    <Tab Title="Grafovi">
        <Content>
            <div class="d-flex">
                <div class="w-25 d-flex flex-column m-3 justify-content-start">
                    <Button Type="BlazorBootstrap.ButtonType.Button"
                            Size="BlazorBootstrap.Size.Small"
                            @onclick="async () => await OnlineTestMaturaSelfAssessmentHandler()"
                            Class="m-2"
                            Style="background-color:#094c79; color:white">
                        Online test / Matura / Samostalna procjena
                    </Button>
                    <Button Type="BlazorBootstrap.ButtonType.Button"
                            Size="BlazorBootstrap.Size.Small"
                            @onclick="async () => await ElektrotehnikaRacunarstvoHandler()"
                            Class="m-2"
                            Style="background-color:#094c79; color:white">
                        Računarstvo / Elektrotehnika
                    </Button>
                    <Button Type="BlazorBootstrap.ButtonType.Button"
                            Size="BlazorBootstrap.Size.Small"
                            @onclick="async () => await PrijediplomskiDiplomskiHandler()"
                            Class="m-2"
                            Style="background-color:#094c79; color:white">
                        Prijediplomski / Diplomski
                    </Button>
                    <Button Type="BlazorBootstrap.ButtonType.Button"
                            Size="BlazorBootstrap.Size.Small"
                            @onclick="async () => await AcademicYearHandler()"
                            Class="m-2"
                            Style="background-color:#094c79; color:white">
                        Usporedba rezultata testa prema godinama studija
                    </Button>
                    <Button Type="BlazorBootstrap.ButtonType.Button"
                            Size="BlazorBootstrap.Size.Small"
                            @onclick="async () => await SelfAssessmentHandler()"
                            Class="m-2"
                            Style="background-color:#094c79; color:white">
                        Samostalna procjena
                    </Button>
                    <Button Type="BlazorBootstrap.ButtonType.Button"
                            Size="BlazorBootstrap.Size.Small"
                            @onclick="async () => await OnlineTestSelfAssessmentComparisonHandler()"
                            Class="m-2"
                            Style="background-color:#094c79; color:white">
                        Usporedba samostalne procjene i online testa
                    </Button>
                    <Button Type="BlazorBootstrap.ButtonType.Button"
                            Size="BlazorBootstrap.Size.Small"
                            @onclick="async () => await OnlineTestMaturaComparisonHandler()"
                            Class="m-2"
                            Style="background-color:#094c79; color:white">
                        Usporedba rezultata mature i online testa
                    </Button>  
                </div>
                @if (isLoading)
                {
                    <div class="w-75 m-3 ms-5  d-flex justify-content-center align-items-center">
                        <div>
                            <Spinner Type="SpinnerType.Border" Color="SpinnerColor.Primary" Size="SpinnerSize.ExtraLarge" />
                        </div>
                    </div>
                }
                else
                {
                    <div class="w-50 m-3 ms-5 p-3 d-flex justify-content-center">
                        <BarChart @ref="barChart" WidthUnit="Unit.Rem" Width="150" Class="mb-4 ms-5" />
                    </div>
                }
            </div>
            <div class="d-flex flex-row justify-content-center">
                @if (isLoading)
                {
                }
                else
                {
                    <PieChart @ref="pieChart1" WidthUnit="Unit.Rem" Width="20" HeightUnit="Unit.Rem" Height="30" Class="me-2"></PieChart>
                    @if (pieChart2visible)
                    {
                        <PieChart @ref="pieChart2" WidthUnit="Unit.Rem" Width="20" HeightUnit="Unit.Rem" Height="30" Class="me-2"></PieChart>
                    }
                    @if (pieChart3visible)
                    {
                        <PieChart @ref="pieChart3" WidthUnit="Unit.Rem" Width="20" HeightUnit="Unit.Rem" Height="30"></PieChart>
                    }
                    @if (pieChart4visible)
                    {
                        <PieChart @ref="pieChart4" WidthUnit="Unit.Rem" Width="20" HeightUnit="Unit.Rem" Height="30"></PieChart>
                    }
                    @if (pieChart5visible)
                    {
                        <PieChart @ref="pieChart5" WidthUnit="Unit.Rem" Width="20" HeightUnit="Unit.Rem" Height="30"></PieChart>
                    }
                }
            </div>
        </Content>
    </Tab>
</Tabs>

@code
{
    bool isLoading = false;
    private IEnumerable<Vresult> results = default!;
    List<LanguageLevel> languageLevels = new();


    private BarChart barChart = default!;
    private BarChartOptions barChartOptions = default!;
    private ChartData barChartData = default!;

    private PieChart pieChart1 = default!;
    private PieChart pieChart2 = default!;
    private PieChart pieChart3 = default!;
    private PieChart pieChart4 = default!;
    private PieChart pieChart5 = default!;
    private PieChartOptions pieChartOptions1 = default!;
    private PieChartOptions pieChartOptions2 = default!;
    private PieChartOptions pieChartOptions3 = default!;
    private PieChartOptions pieChartOptions4 = default!;
    private PieChartOptions pieChartOptions5 = default!;
    private ChartData pieChartData1 = default!;
    private ChartData pieChartData2 = default!;
    private ChartData pieChartData3 = default!;
    private ChartData pieChartData4 = default!;
    private ChartData pieChartData5 = default!;
    bool pieChart2visible = true;
    bool pieChart3visible = true;
    bool pieChart4visible = true;
    bool pieChart5visible = true;

    //preparation and display of grid data
    private async Task<GridDataProviderResult<Vresult>> ResultsDataProvider(GridDataProviderRequest<Vresult> request)
    {
        if (results is null) results = await resultService.GetVResults();
        return await Task.FromResult(request.ApplyTo(results));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await OnlineTestMaturaSelfAssessmentHandler();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    //buttons functions
    private async Task OnlineTestMaturaSelfAssessmentHandler()
    {
        isLoading = true;
        var chartDataTypes = new List<ChartDataTypes> { ChartDataTypes.OnlineTest, ChartDataTypes.Matura, ChartDataTypes.SelfAssessment };
        barChartData = await GetChartDataForLanguageLevel(chartDataTypes);
        pieChartData1 = await GetChartDataForLanguageLevelPercentage(ChartDataTypes.OnlineTest);
        pieChartData2 = await GetChartDataForLanguageLevelPercentage(ChartDataTypes.Matura);
        pieChartData3 = await GetChartDataForLanguageLevelPercentage(ChartDataTypes.SelfAssessment);
        barChartOptions = SetBarChartOptions(ChartTypes.LanguageLevel);
        pieChartOptions1 = SetPieChartOptions(ChartDataTypes.OnlineTest);
        pieChartOptions2 = SetPieChartOptions(ChartDataTypes.Matura);
        pieChartOptions3 = SetPieChartOptions(ChartDataTypes.SelfAssessment);
        isLoading = false;
        pieChart2visible = true;
        pieChart3visible = true;
        pieChart4visible = false;
        pieChart5visible = false;
        StateHasChanged();
        await UpdateCharts();
    }

    private async Task ElektrotehnikaRacunarstvoHandler()
    {
        isLoading = true;
        var chartDataTypes = new List<ChartDataTypes> { ChartDataTypes.Elektrotehnika, ChartDataTypes.Racunarstvo };
        barChartData = await GetChartDataForLanguageLevel(chartDataTypes);
        pieChartData1 = await GetChartDataForLanguageLevelPercentage(ChartDataTypes.Elektrotehnika);
        pieChartData2 = await GetChartDataForLanguageLevelPercentage(ChartDataTypes.Racunarstvo);
        barChartOptions = SetBarChartOptions(ChartTypes.LanguageLevel);
        pieChartOptions1 = SetPieChartOptions(ChartDataTypes.Elektrotehnika);
        pieChartOptions2 = SetPieChartOptions(ChartDataTypes.Racunarstvo);
        isLoading = false;
        pieChart2visible = true;
        pieChart3visible = false;
        pieChart4visible = false;
        pieChart5visible = false;
        StateHasChanged();
        await UpdateCharts();
    }

    private async Task PrijediplomskiDiplomskiHandler()
    {
        isLoading = true;
        var chartDataTypes = new List<ChartDataTypes> { ChartDataTypes.Prijediplomski, ChartDataTypes.Diplomski };
        barChartData = await GetChartDataForLanguageLevel(chartDataTypes);
        pieChartData1 = await GetChartDataForLanguageLevelPercentage(ChartDataTypes.Prijediplomski);
        pieChartData2 = await GetChartDataForLanguageLevelPercentage(ChartDataTypes.Diplomski);
        barChartOptions = SetBarChartOptions(ChartTypes.LanguageLevel);
        pieChartOptions1 = SetPieChartOptions(ChartDataTypes.Prijediplomski);
        pieChartOptions2 = SetPieChartOptions(ChartDataTypes.Diplomski);
        isLoading = false;
        pieChart2visible = true;
        pieChart3visible = false;
        pieChart4visible = false;
        pieChart5visible = false;
        StateHasChanged();
        await UpdateCharts();
    }

    private async Task AcademicYearHandler()
    {
        isLoading = true;
        var chartDataTypes = new List<ChartDataTypes> { ChartDataTypes.Godina_1, ChartDataTypes.Godina_2, ChartDataTypes.Godina_3, ChartDataTypes.Godina_4, ChartDataTypes.Godina_5 };
        barChartData = await GetChartDataForLanguageLevel(chartDataTypes);
        pieChartData1 = await GetChartDataForLanguageLevelPercentage(ChartDataTypes.Godina_1);
        pieChartData2 = await GetChartDataForLanguageLevelPercentage(ChartDataTypes.Godina_2);
        pieChartData3 = await GetChartDataForLanguageLevelPercentage(ChartDataTypes.Godina_3);
        pieChartData4 = await GetChartDataForLanguageLevelPercentage(ChartDataTypes.Godina_4);
        pieChartData5 = await GetChartDataForLanguageLevelPercentage(ChartDataTypes.Godina_5);
        barChartOptions = SetBarChartOptions(ChartTypes.LanguageLevel);
        pieChartOptions1 = SetPieChartOptions(ChartDataTypes.Godina_1);
        pieChartOptions2 = SetPieChartOptions(ChartDataTypes.Godina_2);
        pieChartOptions3 = SetPieChartOptions(ChartDataTypes.Godina_3);
        pieChartOptions4 = SetPieChartOptions(ChartDataTypes.Godina_4);
        pieChartOptions5 = SetPieChartOptions(ChartDataTypes.Godina_5);
        isLoading = false;
        pieChart2visible = true;
        pieChart3visible = true;
        pieChart4visible = true;
        pieChart5visible = true;
        StateHasChanged();
        await UpdateCharts();
    }

    private async Task SelfAssessmentHandler()
    {
        isLoading = true;
        barChartData = await GetChartDataSelfAssessmentCorrectness();
        pieChartData1 = await GetChartDataSelfAssessmentCorrectnessPercentage();
        barChartOptions = SetBarChartOptions(ChartTypes.SelfAssessmentCorrectness);
        pieChartOptions1 = SetPieChartOptions(ChartDataTypes.SelfAssessmentCorrectness);
        isLoading = false;
        pieChart2visible = false;
        pieChart3visible = false;
        pieChart4visible = false;
        pieChart5visible = false;
        StateHasChanged();
        await UpdateCharts();
    }

    private async Task OnlineTestSelfAssessmentComparisonHandler()
    {
        isLoading = true;
        barChartData = await GetChartDataComparison(ChartDataTypes.SelfAssessmentOnlineTest);
        pieChartData1 = await GetChartDataComparisonPercentage(ChartDataTypes.SelfAssessmentOnlineTest);
        barChartOptions = SetBarChartOptions(ChartTypes.Comparison);
        pieChartOptions1 = SetPieChartOptions(ChartDataTypes.SelfAssessmentOnlineTest);
        isLoading = false;
        pieChart2visible = false;
        pieChart3visible = false;
        pieChart4visible = false;
        pieChart5visible = false;
        StateHasChanged();
        await UpdateCharts();
    }

    private async Task OnlineTestMaturaComparisonHandler()
    {
        isLoading = true;
        barChartData = await GetChartDataComparison(ChartDataTypes.MaturaOnlineTest);
        pieChartData1 = await GetChartDataComparisonPercentage(ChartDataTypes.MaturaOnlineTest);
        barChartOptions = SetBarChartOptions(ChartTypes.Comparison);
        pieChartOptions1 = SetPieChartOptions(ChartDataTypes.MaturaOnlineTest);
        isLoading = false;
        pieChart2visible = false;
        pieChart3visible = false;
        pieChart4visible = false;
        pieChart5visible = false;
        StateHasChanged();
        await UpdateCharts();
    }

    //Creating charts
    private async Task UpdateCharts()
    {
        await barChart.InitializeAsync(barChartData, barChartOptions);
        await pieChart1.InitializeAsync(pieChartData1, pieChartOptions1, plugins: new string[] { "ChartDataLabels" });
        if (pieChart2visible) await pieChart2.InitializeAsync(pieChartData2, pieChartOptions2, plugins: new string[] { "ChartDataLabels" });
        if (pieChart3visible) await pieChart3.InitializeAsync(pieChartData3, pieChartOptions3, plugins: new string[] { "ChartDataLabels" });
        if (pieChart4visible) await pieChart4.InitializeAsync(pieChartData4, pieChartOptions4, plugins: new string[] { "ChartDataLabels" });
        if (pieChart5visible) await pieChart5.InitializeAsync(pieChartData5, pieChartOptions5, plugins: new string[] { "ChartDataLabels" });
    }

    //Data preparation

    //Get number of results
    private async Task<int> GetDataForLanguageLevel(int? languageLevel, ChartDataTypes chartDataType)
    {
        var results = await resultService.GetResultsForLanguageLevel(languageLevel, chartDataType);
        var numberOfResults = results.Count();
        return numberOfResults;
    }

    private async Task<int> GetDataForSelfAssessmentCorrect(SelfAssessmentCorrect selfAssessmentCorrect)
    {
        var results = await resultService.GetResultsForSelfAssessmentCorrectness(selfAssessmentCorrect);
        var numberOfResults = results.Count();
        return numberOfResults;
    }

    private async Task<int> GetDataForComparison(ChartDataTypes dataType, Comparison comparison)
    {
        var results = new List<Result>();
        int numberOfResults = 0;
        if(dataType == ChartDataTypes.MaturaOnlineTest)
        {
            results = await resultService.GetResultsForMaturaOnlineTest(comparison);
            numberOfResults = results.Count();
        }
        else if (dataType == ChartDataTypes.SelfAssessmentOnlineTest)
        {
            results = await resultService.GetResultsForSelfAssessmentOnlineTest(comparison);
            numberOfResults = results.Count();
        }
        return numberOfResults;
    }

    //Get percentage of results
    private async Task<double> GetDataPercentageForLanguageLevel(int? languageLevel, ChartDataTypes chartDataType)
    {
        int numberOfAllResults;
        numberOfAllResults = await resultService.GetNumberOfResultsByChartDataType(chartDataType);
        var numberOfResults = await GetDataForLanguageLevel(languageLevel, chartDataType);
        var resultPercentage = (double)((100f * numberOfResults) / numberOfAllResults);
        resultPercentage = Math.Round(resultPercentage * 100.0) / 100.0;
        return resultPercentage;
    }

    private async Task<double> GetDataPercentageForSelfAssessmentCorrect(SelfAssessmentCorrect selfAssessmentCorrect)
    {
        int numberOfAllResults;
        numberOfAllResults = await resultService.GetNumberOfResults();
        var numberOfResults = await GetDataForSelfAssessmentCorrect(selfAssessmentCorrect);
        var resultPercentage = (double)((100f * numberOfResults) / numberOfAllResults);
        resultPercentage = Math.Round(resultPercentage * 100.0) / 100.0;
        return resultPercentage;
    }

    private async Task<double> GetDataPercentageForComparison(ChartDataTypes dataType, Comparison comparison)
    {
        int numberOfAllResults;
        numberOfAllResults = await resultService.GetNumberOfResults();
        var numberOfResults = await GetDataForComparison(dataType, comparison);
        var resultPercentage = (double)((100f * numberOfResults) / numberOfAllResults);
        resultPercentage = Math.Round(resultPercentage * 100.0) / 100.0;
        return resultPercentage;
    }

    // Get dataset for bar chart
    private async Task<List<double>> GetDatasetForLanguageLevels(ChartDataTypes chartDataType)
    {
        var data = new List<double>();
        var languageLevels = await languageLevelService.GetLanguageLevels();
        var numberOfResults = await GetDataForLanguageLevel(null, chartDataType);
        data.Add(numberOfResults);
        foreach (var languageLevel in languageLevels)
        {
            numberOfResults = await GetDataForLanguageLevel(languageLevel.Id, chartDataType);
            data.Add(numberOfResults);
        }
        return data;
    }

    private async Task<List<double>> GetDatasetForSelfAssessmentCorrectness()
    {
        var data = new List<double>();
        var numberOfResults = await GetDataForSelfAssessmentCorrect(SelfAssessmentCorrect.Correct);
        data.Add(numberOfResults);
        numberOfResults = await GetDataForSelfAssessmentCorrect(SelfAssessmentCorrect.Off_by_1);
        data.Add(numberOfResults);
        numberOfResults = await GetDataForSelfAssessmentCorrect(SelfAssessmentCorrect.Off_by_multiple);
        data.Add(numberOfResults);
        return data;
    }

    private async Task<List<double>> GetDatasetForComparison(ChartDataTypes dataType)
    {
        var data = new List<double>();
        var numberOfResults = await GetDataForComparison(dataType, Comparison.Less);
        data.Add(numberOfResults);
        numberOfResults = await GetDataForComparison(dataType, Comparison.Equal);
        data.Add(numberOfResults);
        numberOfResults = await GetDataForComparison(dataType, Comparison.More);
        data.Add(numberOfResults);
        return data;
    }

    private async Task<BarChartDataset> GetDataset(ChartTypes chartType, ChartDataTypes chartDataType, int dataLabelsCount, string[] backgroundColors, int color)
    {
        var data = new List<double>();
        if (chartType == ChartTypes.LanguageLevel)
        {
            data = await GetDatasetForLanguageLevels(chartDataType);
        }
        else if (chartType == ChartTypes.SelfAssessmentCorrectness)
        {
            data = await GetDatasetForSelfAssessmentCorrectness();
        }
        else if (chartType == ChartTypes.Comparison)
        {
            data = await GetDatasetForComparison(chartDataType);
        }
        var c = ColorBuilder.CategoricalTwelveColors[color].ToColor();
        string label = GetNameForChartDataType(chartDataType);
        return new()
            {
                Label = $"{label}",
                Data = data,
                BackgroundColor = new List<string> { c.ToRgbString() },
                BorderColor = new List<string> { c.ToRgbString() },
                BorderWidth = new List<double> { 0 },
            };
    }

    private async Task<List<IChartDataset>> GetDatasets(ChartTypes chartType, List<ChartDataTypes> chartDataTypes, int dataLabelsCount, string[] backgroundColors)
    {
        var datasets = new List<IChartDataset>();
        int color = 0;
        foreach(var chartDataType in chartDataTypes)
        {
            var dataset = await GetDataset(chartType, chartDataType, dataLabelsCount, backgroundColors, color);
            datasets.Add(dataset);
            color += 1;
        }
        return datasets;
    }

    //Get dataset for pie chart
    private async Task<List<double>> GetDatasetForLanguageLevelsPercentage(ChartDataTypes chartDataType)
    {
        var data = new List<double>();
        var languageLevels = await languageLevelService.GetLanguageLevels();
        var percentage = await GetDataPercentageForLanguageLevel(null, chartDataType);
        data.Add(percentage);
        foreach (var languageLevel in languageLevels)
        {
            percentage = await GetDataPercentageForLanguageLevel(languageLevel.Id, chartDataType);
            data.Add(percentage);
        }
        return data;
    }

    private async Task<List<double>> GetDatasetForSelfAssessmentCorrectnessPercentage()
    {
        var data = new List<double>();
        var percentage = await GetDataPercentageForSelfAssessmentCorrect(SelfAssessmentCorrect.Correct);
        data.Add(percentage);
        percentage = await GetDataPercentageForSelfAssessmentCorrect(SelfAssessmentCorrect.Off_by_1);
        data.Add(percentage);
        percentage = await GetDataPercentageForSelfAssessmentCorrect(SelfAssessmentCorrect.Off_by_multiple);
        data.Add(percentage);
        return data;
    }

    private async Task<List<double>> GetDatasetForComparisonPercentage(ChartDataTypes dataType)
    {
        var data = new List<double>();
        var percentage = await GetDataPercentageForComparison(dataType, Comparison.Less);
        data.Add(percentage);
        percentage = await GetDataPercentageForComparison(dataType, Comparison.Equal);
        data.Add(percentage);
        percentage = await GetDataPercentageForComparison(dataType, Comparison.More);
        data.Add(percentage);
        return data;
    }

    private async Task<PieChartDataset> GetDatasetPercentage(ChartTypes chartType, ChartDataTypes chartDataType, int dataLabelsCount, string[] backgroundColors)
    {
        var data = new List<double>();
        if (chartType == ChartTypes.LanguageLevel)
        {
            data = await GetDatasetForLanguageLevelsPercentage(chartDataType);
        }
        else if (chartType == ChartTypes.SelfAssessmentCorrectness)
        {
            data = await GetDatasetForSelfAssessmentCorrectnessPercentage();
        }
        else if (chartType == ChartTypes.Comparison)
        {
            data = await GetDatasetForComparisonPercentage(chartDataType);
        }
        return new() {Datalabels = new PieChartDatasetDataLabels {Anchor = "end"}, Data = data, BackgroundColor = GetRandomBackgroundColors(dataLabelsCount, backgroundColors) };
    }

    private async Task<List<IChartDataset>> GetDatasetsPercentage(ChartTypes chartType, ChartDataTypes chartDataType, int dataLabelsCount, string[] backgroundColors)
    {
        var datasets = new List<IChartDataset>();
        var dataset = await GetDatasetPercentage(chartType, chartDataType, dataLabelsCount, backgroundColors);
        datasets.Add(dataset);
        return datasets;
    }

    private List<string> GetRandomBackgroundColors(int dataLabelsCount, string[] backgroundColors)
    {
        var colors = new List<string>();
        for (var index = 0; index < dataLabelsCount; index++)
        {
            colors.Add(backgroundColors![index]);
        }

        return colors;
    }

    //Get chart data for bar chart
    private async Task<ChartData> GetChartDataForLanguageLevel(List<ChartDataTypes> chartDataTypes)
    {
        BarChart barChart = new();
        string[] backgroundColors = ColorBuilder.CategoricalTwelveColors;
        var labels = await GetLabelsForLanguageLevels();
        var dataLabelsCount = labels.Count();
        var datasets = await GetDatasets(ChartTypes.LanguageLevel, chartDataTypes, dataLabelsCount, backgroundColors);
        return new ChartData { Labels = labels, Datasets = datasets };
    }

    private async Task<ChartData> GetChartDataComparison(ChartDataTypes dataType)
    {
        BarChart barChart = new();
        string[] backgroundColors = ColorBuilder.CategoricalTwelveColors;
        var labels = GetLabelsForComparison(dataType);
        var dataLabelsCount = labels.Count();
        var chartDataTypes = new List<ChartDataTypes> { dataType };
        var datasets = await GetDatasets(ChartTypes.Comparison, chartDataTypes, dataLabelsCount, backgroundColors);
        return new ChartData { Labels = labels, Datasets = datasets };
    }

    private async Task<ChartData> GetChartDataSelfAssessmentCorrectness()
    {
        BarChart barChart = new();
        string[] backgroundColors = ColorBuilder.CategoricalTwelveColors;
        var labels = GetLabelsForCorrectSelfAssessment();
        var dataLabelsCount = labels.Count();
        var chartDataTypes = new List<ChartDataTypes> { ChartDataTypes.SelfAssessmentCorrectness };
        var datasets = await GetDatasets(ChartTypes.SelfAssessmentCorrectness, chartDataTypes, dataLabelsCount, backgroundColors);
        return new ChartData { Labels = labels, Datasets = datasets };
    }

    // Get chart data for pie chart
    private async Task<ChartData> GetChartDataForLanguageLevelPercentage(ChartDataTypes chartDataType)
    {
        PieChart pieChart = new();
        string[] backgroundColors = ColorBuilder.CategoricalTwelveColors;
        var labels = await GetLabelsForLanguageLevels();
        var dataLabelsCount = labels.Count();
        var datasets = await GetDatasetsPercentage(ChartTypes.LanguageLevel, chartDataType, dataLabelsCount, backgroundColors);
        return new ChartData { Labels = labels, Datasets = datasets };
    }

    private async Task<ChartData> GetChartDataComparisonPercentage(ChartDataTypes dataType)
    {
        PieChart pieChart = new();
        string[] backgroundColors = ColorBuilder.CategoricalTwelveColors;
        var labels = GetLabelsForComparison(dataType);
        var dataLabelsCount = labels.Count();
        var datasets = await GetDatasetsPercentage(ChartTypes.Comparison, dataType, dataLabelsCount, backgroundColors);
        return new ChartData { Labels = labels, Datasets = datasets };
    }

    private async Task<ChartData> GetChartDataSelfAssessmentCorrectnessPercentage()
    {
        PieChart pieChart = new();
        string[] backgroundColors = ColorBuilder.CategoricalTwelveColors;
        var labels = GetLabelsForCorrectSelfAssessment();
        var dataLabelsCount = labels.Count();
        var datasets = await GetDatasetsPercentage(ChartTypes.SelfAssessmentCorrectness, ChartDataTypes.SelfAssessmentCorrectness, dataLabelsCount, backgroundColors);
        return new ChartData { Labels = labels, Datasets = datasets };
    }

    //Get labels chart
    private async Task<List<string>> GetLabelsForLanguageLevels()
    {
        List<string> labels = new();
        labels.Add("<A1");
        var languageLevels = await languageLevelService.GetLanguageLevels();
        foreach (var languageLevel in languageLevels)
        {
            labels.Add(languageLevel.Level ?? "");
        }
        return labels;
    }

    private List<string> GetLabelsForCorrectSelfAssessment()
    {
        return new List<string> { "Točna procjena", "Procjena netočna za jednu razinu", "Procjena netočna za više od jedne razine" };
    }

    private List<string> GetLabelsForComparison(ChartDataTypes dataType)
    {
        if (dataType == ChartDataTypes.MaturaOnlineTest)
        {
            return new List<string> {
         "Rezultat online testa lošiji od rezultata mature",
         "Rezultat online testa jednak rezultatu mature ",
         "Rezultat online testa bolji od rezultata mature" };
        }
        else if (dataType == ChartDataTypes.SelfAssessmentOnlineTest)
        {
            return new List<string> {
         "Samostalna procjena bolja od rezultata online testa",
         "Samostalna procjena jednaka rezultatu online testa",
         "Samostalna procjena lošija od rezultata testa" };
        }
        return new List<string>();
    }

    //Chart options
    private BarChartOptions SetBarChartOptions(ChartTypes chartType)
    {

        BarChartOptions barChartOptions = new();
        barChartOptions.Responsive = true;
        barChartOptions.Interaction = new Interaction { Mode = InteractionMode.Index };
        if (chartType == ChartTypes.LanguageLevel)
        {
            barChartOptions.Scales.X.Title.Text = "CEFR razine";
        }
        else if (chartType == ChartTypes.SelfAssessmentCorrectness)
        {
            barChartOptions.Scales.X.Title.Text = "Točnost samostalne procjene";
        }
        else if (chartType == ChartTypes.Comparison)
        {
            barChartOptions.Scales.X.Title.Text = "Usporedba";
        }
        else
        {
            barChartOptions.Scales.X.Title.Text = "Rezultati";
        }
        barChartOptions.Scales.X.Title.Display = true;
        barChartOptions.Scales.Y.Title.Text = "Broj ispitanika";
        barChartOptions.Scales.Y.Title.Display = true;

        return barChartOptions;
    }

    private PieChartOptions SetPieChartOptions(ChartDataTypes chartDataType)
    {

        PieChartOptions pieChartOptions = new();
        pieChartOptions.Responsive = true;
        string title = GetNameForChartDataType(chartDataType);
        title = title + "  [%]";
        pieChartOptions.Plugins.Title!.Text = title;
        pieChartOptions.Plugins.Title.Display = true;
        pieChartOptions.Plugins.Legend.Position = "bottom";
        return pieChartOptions;
    }

    private string GetNameForChartDataType(ChartDataTypes chartDataType)
    {
        string name = "";
        if (chartDataType == ChartDataTypes.OnlineTest)
        {
            name = "Online test";
        }
        else if (chartDataType == ChartDataTypes.Matura)
        {
            name = "Matura";
        }
        else if (chartDataType == ChartDataTypes.SelfAssessment)
        {
            name = "Samostalna procjena";
        }
        else if (chartDataType == ChartDataTypes.Racunarstvo)
        {
            name = "Računarstvo";
        }
        else if (chartDataType == ChartDataTypes.Elektrotehnika)
        {
            name = "Elektrotehnika";
        }
        else if (chartDataType == ChartDataTypes.Godina_1)
        {
            name = "1. godina prijediplomskog studija";
        }
        else if (chartDataType == ChartDataTypes.Godina_2)
        {
            name = "2. godina prijediplomskog studija";
        }
        else if (chartDataType == ChartDataTypes.Godina_3)
        {
            name = "3. godina prijediplomskog studija";
        }
        else if (chartDataType == ChartDataTypes.Godina_4)
        {
            name = "1. godina diplomskog studija";
        }
        else if (chartDataType == ChartDataTypes.Godina_5)
        {
            name = "2. godina diplomskog studija";
        }
        else if (chartDataType == ChartDataTypes.Prijediplomski)
        {
            name = "Prijediplomski";
        }
        else if (chartDataType == ChartDataTypes.Diplomski)
        {
            name = "Diplomski";
        }
        else if (chartDataType == ChartDataTypes.SelfAssessmentCorrectness)
        {
            name = "Točnost samostalne procjene";
        }
        else if (chartDataType == ChartDataTypes.SelfAssessmentOnlineTest)
        {
            name = "Usporedba samostalne procjene i online testa";
        }
        else if (chartDataType == ChartDataTypes.MaturaOnlineTest)
        {
            name = "Usporedba mature i online testa";
        }
        else
        {
            name = "Rezultati";
        }
        return name;
    }
